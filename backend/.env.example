PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/SecureOrg?schema=public"

# Cryptographic and Session Secrets
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
SESSION_SECRET=your_session_secret_here

# Security Policies
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12

#FIDO2 tab to the real browser WebAuthn API
WEBAUTHN_RP_NAME=your_WEBAUTHN_RP_NAME
WEBAUTHN_RP_ID=your_WEBAUTHN_RP_ID
WEBAUTHN_ORIGIN=http://localhost:5173
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=
#MFA
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_DURATION_MINUTES=15
MFA_CHALLENGE_EXPIRY_MINUTES=5
MFA_ENROLLMENT_EXPIRY_MINUTES=10